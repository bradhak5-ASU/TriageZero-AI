# Deployment variables for docs/DEPLOYMENT.md.
#
# Copy to `deploy.env` (which is gitignored) and fill in YOUR values:
#     cp deploy.env.example deploy.env
#     $EDITOR deploy.env
#     set -a && source deploy.env && set +a
#
# NEVER commit deploy.env. Nothing in this file is read by the application at
# runtime - it exists so the runbook's commands have their variables set in
# your shell, and so your real identifiers live in exactly one ignored file.

# --- identifiers (keep private) ---------------------------------------------
# Your billing account is not a credential - nobody can charge it without an
# IAM grant - but it identifies your account and does not belong in a public
# repository.
export BILLING_ACCOUNT="XXXXXX-XXXXXX-XXXXXX"

# Globally unique and permanent. Note: this WILL become publicly visible once
# deployed - it appears in the Firebase authDomain that ships in the browser
# bundle. Treat it as private-ish, not secret.
export PROJECT_ID="triagezero-demo"
export REGION="us-central1"

# --- Cloud SQL --------------------------------------------------------------
export SQL_INSTANCE="triagezero-db"
export DB_NAME="triagezero"
export DB_USER="tzapp"
# Generate rather than invent, and never write a chosen password here by hand:
#     export DB_PASSWORD="$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)"
export DB_PASSWORD=""

# --- Gemini -----------------------------------------------------------------
# A real secret. Goes into Secret Manager in Phase 2 and nowhere else.
export GEMINI_API_KEY=""

# --- Firebase web config (PUBLIC by design) ---------------------------------
# These identify the project to Google and are built into the browser bundle.
# They are NOT secrets. They are here only so the Phase 5 build command can
# reference them.
export FIREBASE_API_KEY=""
export FIREBASE_AUTH_DOMAIN=""
export FIREBASE_APP_ID=""

# --- filled in during Phase 5 ------------------------------------------------
# Learned from the first deploy; both are public URLs.
export SQL_CONNECTION_NAME=""
export API_URL=""
export WEB_URL=""
