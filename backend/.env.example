# TriageZero backend configuration.
# Copy to backend/.env and adjust. Never commit a real .env.
# Every credential value below is intentionally BLANK.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DATABASE_URL=sqlite:///./data/triagezero.db
FRONTEND_ORIGINS=http://localhost:5174
MAX_REQUEST_BYTES=2097152
LOCAL_PROCESSING_DELAY_MS=250
LOG_LEVEL=INFO

# --- analysis provider ------------------------------------------------------
# deterministic | gemini | gemini_adk
# Default is deterministic: fully local, no credentials, no network.
ANALYZER_MODE=deterministic

# When a model provider fails or is unconfigured, fall back to the
# deterministic analyzer (true) or mark the investigation needs_review (false).
AI_FALLBACK_ENABLED=true

# Leave BLANK here. Put a real key only in backend/.env, which is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Vertex AI instead of the Gemini Developer API (optional).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

AI_PROMPT_VERSION=v1
