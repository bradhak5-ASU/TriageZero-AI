# TriageZero backend configuration.
# Copy to backend/.env and adjust. Never commit a real .env.
# Every credential value below is intentionally BLANK.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# --- datastore --------------------------------------------------------------
# SQLite is correct for local development: the file is durable on your machine.
#
# It is NOT usable in staging/production. Cloud Run gives each container an
# ephemeral filesystem, so a SQLite database there is erased on every restart,
# redeploy and scale-to-zero - silently, with no error. The backend refuses to
# start with a SQLite URL when APP_ENV is staging or production.
#
# Cloud SQL over the Unix socket (note the empty host and the ?host= param):
#   postgresql+psycopg://USER:PASSWORD@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
# Plain TCP PostgreSQL:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
# `postgres://` and `postgresql://` are accepted and rewritten to the psycopg
# driver, so a URL copied from a managed service works as-is.
DATABASE_URL=sqlite:///./data/triagezero.db

# Exact browser origin(s) allowed to call this API, comma-separated.
# In staging/production these must be https:// and must not end in a slash -
# a browser sends the origin with no trailing slash, so one here never matches.
FRONTEND_ORIGINS=http://localhost:5174
MAX_REQUEST_BYTES=2097152
LOCAL_PROCESSING_DELAY_MS=250
LOG_LEVEL=INFO

# --- API authentication ----------------------------------------------------
# Local development may leave this false. Staging/production require true and
# two distinct random tokens of at least 32 characters. Store real values only
# in backend/.env locally and in Secret Manager when deployed.
API_AUTH_REQUIRED=false
INGESTION_API_TOKEN=
DASHBOARD_API_TOKEN=

# --- human sign-in (Firebase) -----------------------------------------------
# Verified with Application Default Credentials — no service-account JSON file
# belongs in this repository. Machines keep using INGESTION_API_TOKEN.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=

# --- analysis provider ------------------------------------------------------
# deterministic | gemini | gemini_adk
# Default is deterministic: fully local, no credentials, no network.
ANALYZER_MODE=deterministic

# When a model provider fails or is unconfigured, fall back to the
# deterministic analyzer (true) or mark the investigation needs_review (false).
AI_FALLBACK_ENABLED=true

# Leave BLANK here. Put a real key only in backend/.env, which is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
# ADK can perform multiple model/tool turns, so it has its own total deadline.
ADK_REQUEST_TIMEOUT_SECONDS=120

# Vertex AI instead of the Gemini Developer API (optional).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

AI_PROMPT_VERSION=v2
