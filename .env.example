# TriageZero frontend configuration.
# Copy to .env and adjust. Never commit a real .env file.

# Base URL of the TriageZero ingestion/investigation API
VITE_API_BASE_URL=http://localhost:8001

# true = fully local demo mode with mock data (no backend required)
# false = talk to the real API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# --- Firebase Authentication (human sign-in) --------------------------------
# These are Firebase's PUBLIC web configuration values: they identify the
# project to Google and are designed to ship in a browser bundle. They are NOT
# a private credential. Never put a backend secret or the ingestion token here.
# Leave blank to run without sign-in (local demo mode).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
