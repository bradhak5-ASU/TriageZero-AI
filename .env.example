# TriageZero frontend configuration.
# Copy to .env and adjust. Never commit a real .env file.

# Base URL of the TriageZero ingestion/investigation API
VITE_API_BASE_URL=http://localhost:8000

# true = fully local demo mode with mock data (no backend required)
# false = talk to the real API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true
